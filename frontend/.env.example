# Database Connection (from prisma/.env)
# Organization Name (used in the UI)
NEXT_PUBLIC_APP_NAME="E-Voting System"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Resend API Key for Email Verification
# Get yours at: https://resend.com/api-keys
RESEND_API_KEY="re_123456789"
EMAIL_FROM="verify@yourdomain.com"

# This points to the default Postgres mapping if you're using docker-compose
DATABASE_URL="postgresql://user:password@localhost:5432/evoting-db?schema=public"

# Auth.js / NextAuth Configuration
# Generate a secret with: npx auth secret
AUTH_SECRET="your-32-character-secret-here"
AUTH_URL="http://localhost:3001" # In production set this to your domain (e.g., https://evoting.sundaresan.dev)
NEXTAUTH_URL="http://localhost:3001" # Keep this equal to AUTH_URL for compatibility with Auth.js/NextAuth hosting setups

# Google OAuth Credentials
# Setup guide: https://console.cloud.google.com/apis/credentials
# 1. Create a project -> Enable "Google+ API" or "Google Identity"
# 2. Go to "Credentials" -> "Create Credentials" -> "OAuth 2.0 Client ID"
# 3. Application type: Web application
# 4. Authorized JavaScript origins: http://localhost:3001
# 5. Authorized redirect URIs: http://localhost:3001/api/auth/callback/google
# For production, replace localhost:3001 with your actual domain
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_ALLOWED_DOMAINS=""

# ImageKit configuration for Profile & Symbol Hosting
# Get these at: https://imagekit.io/dashboard/developer/api-keys
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="public_..."
IMAGEKIT_PRIVATE_KEY="private_..."
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_id"
