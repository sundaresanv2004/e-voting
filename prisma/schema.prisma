generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  role     UserRole @default(user)
  isActive Boolean  @default(true)

  // Custom App Security Fields
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  lastFailedLoginAt DateTime?
  authVersion       Int       @default(1)

  createdOrganizations    Organization[]         @relation("CreatedBy")
  updatedOrganizations    Organization[]         @relation("OrganizationUpdatedBy")
  ownedOrganizations      Organization[]         @relation("OrganizationOwner")
  createdElections        Election[]             @relation("ElectionCreator")
  updatedElections        Election[]             @relation("ElectionUpdatedBy")
  createdElectionSettings ElectionSettings[]     @relation("ElectionSettingsCreatedBy")
  updatedElectionSettings ElectionSettings[]     @relation("ElectionSettingsUpdatedBy")
  createdOrgSettings      OrganizationSettings[] @relation("SettingsCreatedBy")
  updatedOrgSettings      OrganizationSettings[] @relation("UpdatedBy")
  createdElectionRoles    ElectionRole[]         @relation("ElectionRoleCreatedBy")
  updatedElectionRoles    ElectionRole[]         @relation("ElectionRoleUpdatedBy")
  createdCandidates       Candidate[]            @relation("CandidateCreatedBy")
  updatedCandidates       Candidate[]            @relation("CandidateUpdatedBy")
  createdCategories       ElectionCategory[]     @relation("CategoryCreatedBy")
  updatedCategories       ElectionCategory[]     @relation("CategoryUpdatedBy")
  userAuditLogs           UserAuditLog[]
  adminAuditLogs          AdminAuditLog[]
  generatedResults        ElectionResult[]       @relation("ResultGeneratedBy")

  hasAllElectionsAccess Boolean              @default(false)
  electionAccess        UserElectionAccess[] @relation("UserElections")
  createdAccess         UserElectionAccess[] @relation("AccessCreatedBy")
  updatedAccess         UserElectionAccess[] @relation("AccessUpdatedBy")
  createdVoters         Voter[]              @relation("VoterCreatedBy")
  updatedVoters         Voter[]              @relation("VoterUpdatedBy")

  twoFactorEnabled Boolean     @default(false)
  twoFactors       TwoFactor[]

  // Better Auth Admin Plugin Fields
  banned     Boolean?
  banReason  String?
  banExpires DateTime?

  @@unique([email])
  @@map("user")
}

model Organization {
  id              String           @id
  name            String
  // better-auth UI routing identifier
  slug            String
  logo            String?
  createdAt       DateTime
  metadata        String?
  type            OrganizationType
  // Custom business logic identifier for election grouping
  code            String           @unique
  createdByUserId String?
  updatedByUserId String?
  isActive        Boolean          @default(true)
  updatedAt       DateTime         @updatedAt

  creator User?   @relation("CreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updater User?   @relation("OrganizationUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  ownerId String?
  owner   User?   @relation("OrganizationOwner", fields: [ownerId], references: [id])

  members        Member[]
  invitations    Invitation[]
  elections      Election[]
  adminAuditLogs AdminAuditLog[]
  settings       OrganizationSettings?

  @@unique([slug])
  @@map("organization")
}

model OrganizationSettings {
  id             String @id @default(cuid())
  organizationId String @unique

  // Organization Configuration Settings
  maxElections        Int     @default(5)
  maxMembers          Int     @default(100)
  allowCustomBranding Boolean @default(false)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  createdByUserId String?
  updatedByUserId String?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User?        @relation("SettingsCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy       User?        @relation("UpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
}

enum AuditStatus {
  SUCCESS
  FAILURE
  WARNING
  INFO
}

enum AuditEntityType {
  ORGANIZATION
  USER
  ELECTION
  ELECTION_ROLE
  ELECTION_CATEGORY
  CANDIDATE
  BALLOT
  VOTER
  SETTINGS
  AUTH
  SECURITY
  RESULT
  MEMBER
  ACCESS
}

enum UserRole {
  user
  admin
  staff
  viewer
  org_admin
}

enum OrganizationType {
  SCHOOL
  COLLEGE
  OTHER
}

enum ElectionStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

model Election {
  id              String         @id @default(cuid())
  organizationId  String
  name            String
  code            String         @unique
  startTime       DateTime
  endTime         DateTime
  status          ElectionStatus @default(UPCOMING)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime? // soft delete — never hard-delete elections

  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy         User?                @relation("ElectionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy         User?                @relation("ElectionUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  settings          ElectionSettings?
  result            ElectionResult?
  roles             ElectionRole[]
  categories        ElectionCategory[]
  ballots           Ballot[]
  voters            Voter[]
  accessibleByUsers UserElectionAccess[] @relation("ElectionUsers")

  @@index([organizationId])
  @@index([startTime, endTime])
  @@index([status])
  @@index([deletedAt])
}

model ElectionSettings {
  id                    String   @id @default(cuid())
  electionId            String   @unique
  allowOnlineVoting     Boolean  @default(true)
  authorizeVoters       Boolean  @default(true)
  showCandidateProfiles Boolean  @default(true)
  showCandidateSymbols  Boolean  @default(true)
  shuffleCandidates     Boolean  @default(true)
  allowMultipleVotes    Boolean  @default(false)
  allowNota             Boolean  @default(false)
  showSummary           Boolean  @default(true)
  inOrgElection         Boolean  @default(false)
  lockResult            Boolean  @default(false)
  assignVoterToSystem   Boolean  @default(false)
  maxVotesPerUser       Int      @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  createdByUserId       String?
  updatedByUserId       String?

  election  Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("ElectionSettingsCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User?    @relation("ElectionSettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
}

model ElectionCategory {
  id              String   @id @default(cuid())
  electionId      String
  name            String
  code            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?
  updatedByUserId String?

  election  Election       @relation(fields: [electionId], references: [id], onDelete: Cascade)
  roles     ElectionRole[] @relation("CategoryRoles")
  ballots   Ballot[]
  createdBy User?          @relation("CategoryCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User?          @relation("CategoryUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([electionId, code])
  @@index([electionId])
}

model ElectionRole {
  id              String   @id @default(cuid())
  electionId      String
  name            String
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?
  updatedByUserId String?

  election   Election           @relation(fields: [electionId], references: [id], onDelete: Cascade)
  createdBy  User?              @relation("ElectionRoleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy  User?              @relation("ElectionRoleUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  categories ElectionCategory[] @relation("CategoryRoles")
  candidates Candidate[]
  votes      Vote[]
  results    CandidateResult[]

  @@unique([electionId, name])
  @@unique([electionId, order])
}

model Candidate {
  id              String    @id @default(cuid())
  electionRoleId  String
  name            String
  profileImage    String?
  symbolImage     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime? // soft delete — preserves vote integrity
  createdByUserId String?
  updatedByUserId String?

  role      ElectionRole      @relation(fields: [electionRoleId], references: [id], onDelete: Cascade)
  createdBy User?             @relation("CandidateCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User?             @relation("CandidateUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  votes     Vote[]
  results   CandidateResult[]

  @@unique([electionRoleId, name])
  @@index([electionRoleId])
  @@index([createdByUserId])
}

model Ballot {
  id            String    @id @default(cuid())
  electionId    String
  categoryId    String?
  submissionKey String    @unique
  isAnonymous   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  deletedAt     DateTime? // soft delete — never hard-delete ballots

  election Election          @relation(fields: [electionId], references: [id], onDelete: Restrict)
  category ElectionCategory? @relation(fields: [categoryId], references: [id])
  voterId  String?
  voter    Voter?            @relation(fields: [voterId], references: [id])
  votes    Vote[]

  // Belt-and-suspenders: one ballot per voter per election at the DB level
  @@unique([voterId, electionId])
  // Application MUST use atomic UPDATE Voter SET ballotCount = ballotCount + 1... pattern
  @@index([electionId, voterId])
  @@index([electionId])
  @@index([categoryId])
  @@index([createdAt])
}

model Vote {
  id             String    @id @default(cuid())
  ballotId       String
  electionRoleId String
  candidateId    String?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime? // soft delete — votes must never be destroyed

  ballot    Ballot       @relation(fields: [ballotId], references: [id], onDelete: Restrict)
  role      ElectionRole @relation(fields: [electionRoleId], references: [id], onDelete: Restrict)
  candidate Candidate?   @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@unique([ballotId, electionRoleId])
  @@index([ballotId])
  @@index([candidateId])
  @@index([electionRoleId])
  @@index([createdAt])
}

model UserElectionAccess {
  id         String @id @default(cuid())
  userId     String
  electionId String

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?
  updatedByUserId String?

  user      User     @relation("UserElections", fields: [userId], references: [id], onDelete: Cascade)
  election  Election @relation("ElectionUsers", fields: [electionId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("AccessCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User?    @relation("AccessUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, electionId])
  @@index([userId])
  @@index([electionId])
}

model Voter {
  id                String    @id @default(cuid())
  electionId        String
  uniqueId          String
  name              String
  image             String?
  additionalDetails Json?
  ballotCount       Int       @default(0)
  lastVotedAt       DateTime?

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  ballots  Ballot[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?
  updatedByUserId String?

  createdBy User? @relation("VoterCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User? @relation("VoterUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([electionId, uniqueId])
  @@index([electionId])
  @@index([createdByUserId])
  @@index([updatedByUserId])
}

model UserAuditLog {
  id        String      @id @default(cuid())
  userId    String?
  email     String?
  action    String
  status    AuditStatus
  reason    String?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([email])
  @@index([action])
  @@index([createdAt])
}

model AdminAuditLog {
  id             String          @id @default(cuid())
  adminId        String?
  organizationId String?
  action         String
  entityType     AuditEntityType
  status         AuditStatus     @default(INFO)
  entityId       String?
  description    String?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime        @default(now())

  admin        User?         @relation(fields: [adminId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model ElectionResult {
  id                String    @id @default(cuid())
  electionId        String    @unique
  totalVoters       Int
  totalBallots      Int
  turnoutPercentage Float?
  resultData        Json
  isAnonymous       Boolean   @default(false)
  isFinalized       Boolean   @default(false)
  finalizedAt       DateTime?
  generatedAt       DateTime  @default(now())
  generatedByUserId String?

  election         Election          @relation(fields: [electionId], references: [id], onDelete: Cascade)
  generatedBy      User?             @relation("ResultGeneratedBy", fields: [generatedByUserId], references: [id], onDelete: SetNull)
  candidateResults CandidateResult[]

  @@index([generatedByUserId])
}

model CandidateResult {
  id               String   @id @default(cuid())
  electionResultId String
  roleId           String
  candidateId      String
  voteCount        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  electionResult ElectionResult @relation(fields: [electionResultId], references: [id], onDelete: Cascade)
  role           ElectionRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  candidate      Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([roleId, candidateId])
  @@index([electionResultId])
  @@index([roleId])
  @@index([candidateId])
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Organization-specific role — uses the application UserRole enum for consistency
  role      UserRole @default(viewer)
  createdAt DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

model TwoFactor {
  id          String @id
  secret      String
  backupCodes String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("twoFactor")
}
