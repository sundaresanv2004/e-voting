# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Dummy PostgreSQL Database connection string
DATABASE_URL="postgresql://myuser:password@localhost:5432/mydb?schema=public"

# Authentication (Better Auth)
BETTER_AUTH_SECRET="dummy_secret_replace_me_with_random_string"
BETTER_AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OAuth (Google)
GOOGLE_CLIENT_ID="dummy_google_client_id"
GOOGLE_CLIENT_SECRET="dummy_google_client_secret"

# Email Sending (Resend)
RESEND_API_KEY="re_dummy_resend_api_key"
EMAIL_FROM="onboarding@resend.dev"
