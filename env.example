# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Docker Compose PostgreSQL Database Settings
POSTGRES_USER="myuser"
POSTGRES_PASSWORD="mypassword"
POSTGRES_DB="e_voting"

# Dummy PostgreSQL Database connection string (constructed from above for Prisma)
DATABASE_URL="postgresql://myuser:mypassword@db:5432/e_voting?schema=public"

# Authentication (Better Auth)
BETTER_AUTH_SECRET="dummy_secret_replace_me_with_random_string"
# BETTER_AUTH_URL is hardcoded to http://localhost inside docker-compose.yml.
# It is server-side only so it never needs to change. You can remove this from your .env.
BETTER_AUTH_URL="http://localhost"

# Voting security secret (used for signing voter session JWTs)
VOTING_SECRET="dummy_voting_secret_replace_me_with_random_string"

# App
# Set to the hostname you added to the Windows hosts file on all lab machines.
# e.g. if you added "192.168.x.x   evote" to each machine's hosts file, use http://evote
# This hostname never changes even if the server's IP changes after a power cut.
NEXT_PUBLIC_APP_URL="http://evote"
LOCAL_LAB_MODE="true" # Set to true to allow insecure cookies when hosting locally over HTTP

# OAuth (Google)
GOOGLE_CLIENT_ID="dummy_google_client_id"
GOOGLE_CLIENT_SECRET="dummy_google_client_secret"

# Email Sending (Resend)
RESEND_API_KEY="re_dummy_resend_api_key"
EMAIL_FROM="onboarding@resend.dev"

# ImageKit configuration for Profile & Symbol Hosting
# Get these at: https://imagekit.io/dashboard/developer/api-keys
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="public_your_public_key_here"
IMAGEKIT_PRIVATE_KEY="private_your_private_key_here"
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_endpoint_here"

# Contact
NEXT_PUBLIC_CONTACT_MAIL="contact@yourdomain.com"